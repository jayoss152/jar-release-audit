{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JAR Release Audit report version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "complete", "entriesScanned", "summary", "findings", "issues"],
  "properties": {
    "schemaVersion": {"const": 2},
    "complete": {"type": "boolean"},
    "entriesScanned": {"type": "integer", "minimum": 0},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["low", "medium", "high", "issues"],
      "properties": {
        "low": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "issues": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["severity", "rule", "entry", "message"],
        "properties": {
          "severity": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "rule": {"enum": ["SOURCE_FILE", "DEBUG_METADATA", "SENSITIVE_FILE", "SECRET_ASSIGNMENT", "PRIVATE_KEY"]},
          "entry": {"type": "string"}, "message": {"type": "string"}
        }
      }
    },
    "issues": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "entry", "message"],
        "properties": {
          "code": {"enum": ["ENTRY_COUNT_LIMIT", "ENTRY_SIZE_LIMIT", "EXPANDED_SIZE_LIMIT", "NESTING_DEPTH_LIMIT", "AMBIGUOUS_ENTRY", "INVALID_CLASS", "INVALID_TEXT", "ARCHIVE_INTEGRITY", "ENTRY_READ_ERROR"]},
          "entry": {"type": "string"}, "message": {"type": "string"}
        }
      }
    }
  }
}
